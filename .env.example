# ==============================================================================
# SECURE CONFIGURATION TEMPLATE - NEVER HARDCODE SECRETS IN CODE
# ==============================================================================

# Google Cloud Project Configuration
# If GCP_PROJECT_ID is provided, secrets will be fetched dynamically from GCP Secret Manager.
GCP_PROJECT_ID=
USE_SECRET_MANAGER=false

# Google Gemini API Key (Fallback if Secret Manager is not active)
# In GCP Secret Manager, store this under secret name: 'gemini-api-key'
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
# In GCP Secret Manager, store the service account JSON in: 'firebase-service-account'
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
